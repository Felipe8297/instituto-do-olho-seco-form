# ============================================================
# Variáveis de ambiente — copie este arquivo para .env.local
# e preencha os valores reais. .env.local NÃO vai pro git.
# ============================================================

# Chave da API da Resend (criada em https://resend.com/api-keys)
# Fica SÓ no servidor. Nunca colocar no front-end.
RESEND_API_KEY=

# Remetente do e-mail.
# - Testes: onboarding@resend.dev (só entrega para o e-mail dono da conta Resend)
# - Produção: um endereço de um domínio verificado no Resend, ex: triagem@institutodoolhoseco.com.br
RESEND_FROM=triagem@institutodoolhoseco.com.br

# Destinatário do relatório (lado servidor / fallback).
REPORT_EMAIL=institutodoolhoseco@gmail.com

# Destinatário exposto ao front-end (opcional; sobrepõe REPORT_EMAIL no envio).
# Deixe igual ao REPORT_EMAIL. Prefixo NEXT_PUBLIC_ = visível no navegador.
NEXT_PUBLIC_REPORT_EMAIL=institutodoolhoseco@gmail.com
