# ============================================================
# Variáveis de ambiente — copie este arquivo para .env.local
# e preencha os valores reais. .env.local NÃO vai pro git.
# ============================================================
#
# Estratégia atual (sem domínio próprio): a conta do Resend precisa ser criada
# COM o mesmo e-mail do destinatário (REPORT_EMAIL). Assim o remetente
# onboarding@resend.dev pode entregar o relatório sem verificar domínio.

# Chave (Sending access) da conta Resend do instituto — https://resend.com/api-keys
RESEND_API_KEY=

# Remetente. onboarding@resend.dev funciona sem domínio verificado.
# (Só troque por um endereço @institutodoolhoseco.com.br se um dia verificar o domínio.)
RESEND_FROM=onboarding@resend.dev

# Destinatário do relatório por e-mail (usado apenas como FALLBACK).
REPORT_EMAIL=checkinvizon@gmail.com

# ============================================================
# API Sivoe — fluxo principal: grava a triagem no prontuário do paciente.
# Autenticação HMAC-SHA256; o SECRET fica SÓ no servidor.
# NUNCA prefixe com NEXT_PUBLIC_ (isso vazaria o segredo no bundle do cliente).
# Docs: https://developer.sivoe.med.br
# ============================================================
SIVOE_API_BASE=https://api.sivoe.med.br
SIVOE_API_KEY=
SIVOE_API_SECRET=

# ============================================================
# Google Sheets — consolida TODAS as triagens numa planilha do Drive.
# Autenticação por conta de serviço (service account). As credenciais
# ficam SÓ no servidor — NUNCA prefixe com NEXT_PUBLIC_.
#
# Passo a passo:
#  1. console.cloud.google.com -> crie um projeto -> ative a "Google Sheets API".
#  2. Crie uma conta de serviço e gere uma chave JSON (baixa o arquivo).
#  3. Crie a planilha no Drive do institutodoolhoseco@gmail.com e COMPARTILHE
#     com o e-mail da conta de serviço (client_email do JSON) como "Editor".
#  4. Copie os valores do JSON para as variáveis abaixo.
# ============================================================
# ID da planilha (parte da URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEETS_ID=
# "client_email" do JSON da conta de serviço
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" do JSON. Cole entre aspas e mantenha os \n literais, ex.:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Nome da aba onde as linhas são gravadas (opcional; padrão "Respostas")
GOOGLE_SHEETS_TAB=Respostas
